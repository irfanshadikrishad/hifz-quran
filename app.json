{
	"expo": {
		"name": "hifz-quran",
		"slug": "hifz-quran",
		"version": "1.0.0",
		"orientation": "portrait",
		"icon": "./assets/images/logo.jpg",
		"scheme": "hifzquran",
		"userInterfaceStyle": "automatic",
		"newArchEnabled": true,
		"ios": {
			"supportsTablet": true
		},
		"android": {
			"adaptiveIcon": {
				"foregroundImage": "./assets/images/logo.jpg",
				"backgroundColor": "#252525"
			},
			"edgeToEdgeEnabled": true,
			"package": "io.irfanshadikrishad.hifzquran"
		},
		"web": {
			"bundler": "metro",
			"output": "static",
			"favicon": "./assets/images/favicon.png"
		},
		"plugins": [
			"expo-router",
			[
				"expo-splash-screen",
				{
					"image": "./assets/images/splash-icon.png",
					"imageWidth": 200,
					"resizeMode": "contain",
					"backgroundColor": "#151718"
				}
			]
		],
		"experiments": {
			"typedRoutes": true
		},
		"extra": {
			"router": {},
			"eas": {
				"projectId": "513cef74-7e16-4929-89a1-57a84c0a90d7"
			}
		}
	}
}
